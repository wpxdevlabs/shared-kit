{
  "name": "@wpxdev/utils",
  "version": "0.2.2",
  "description": "Shared, dependency-free TypeScript utilities",
  "repository": {
    "type": "git",
    "url": "https://github.com/wpxdevlabs/shared-kit",
    "directory": "packages/utils"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./clamp": {
      "types": "./dist/clamp.d.ts",
      "import": "./dist/clamp.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/clamp.ts src/cn.ts --format esm --dts --sourcemap --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  }
}
