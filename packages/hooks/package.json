{
  "name": "@wpxdev/hooks",
  "version": "0.2.1",
  "description": "Reusable React hooks",
  "repository": {
    "type": "git",
    "url": "https://github.com/wpxdevlabs/shared-kit",
    "directory": "packages/hooks"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./use-debounced-value": {
      "types": "./dist/use-debounced-value.d.ts",
      "import": "./dist/use-debounced-value.js"
    },
    "./use-media-query": {
      "types": "./dist/use-media-query.d.ts",
      "import": "./dist/use-media-query.js"
    },
    "./autosave": {
      "types": "./dist/autosave.d.ts",
      "import": "./dist/autosave.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/autosave.ts src/use-debounced-value.ts src/use-media-query.ts --format esm --dts --sourcemap --clean --external react",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
