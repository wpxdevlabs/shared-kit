{
  "name": "shared-kit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "clean": "pnpm --recursive --if-present clean",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "node --test scripts/braces-security.test.cjs && pnpm --recursive --if-present test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "@tailwindcss/cli>@parcel/watcher": "2.6.0"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild-sass-plugin": "^3.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.0",
    "sass-embedded": "^1.105.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
